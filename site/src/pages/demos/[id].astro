---
import Base from "../../layouts/Base.astro";
import {
	type Game,
	gameJsonLd,
	games,
	href,
	pageHref,
	playHref,
	REPO_BRANCH,
	REPO_URL,
	shot,
	sourceUrl,
} from "../../lib/site";

export function getStaticPaths() {
	return games.map((game) => ({ params: { id: game.id }, props: { game } }));
}

interface Props {
	game: Game;
}
const { game } = Astro.props;
const i = games.indexOf(game);
// The next three games, wrapping around.
const more = [1, 2, 3]
	.map((k) => games[(i + k) % games.length])
	.filter((g): g is Game => g !== undefined && g.id !== game.id);
const breadcrumbs = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Demos",
			item: new URL(href("demos/"), Astro.site).href,
		},
		{
			"@type": "ListItem",
			position: 2,
			name: game.name,
			item: new URL(pageHref(game), Astro.site).href,
		},
	],
};
---

<Base
	title={`${game.name}: a Pebble3D demo`}
	fullTitle
	description={`${game.blurb} Play it in your browser, then see the engine features and recipes behind it.`}
	ogImage={`og/${game.id}.jpg`}
	nav="demos"
	jsonLd={[gameJsonLd(game), breadcrumbs]}
>
	<nav class="wrap breadcrumb" aria-label="Breadcrumb">
		<a href={href("demos/")}>Demos</a> / {game.name}
	</nav>

	<section class="wrap play-hero">
		<div class="play-frame">
			<img
				src={shot(game)}
				alt={game.screenshots[0]?.alt}
				width="1280"
				height="720"
				fetchpriority="high"
			/>
			<div class="overlay">
				<a class="play-btn" href={playHref(game)}>
					<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
						<path d="M4 2l12 7-12 7z" fill="#1A0E07"></path>
					</svg>
					Play {game.name}
				</a>
			</div>
		</div>
		<p class="note">
			{
				game.webglFallback
					? "Runs in your browser. Best in Chrome or Edge with WebGPU; other browsers use the WebGL fallback automatically. Desktop with a keyboard and mouse recommended."
					: "Runs in your browser with WebGPU (Chrome or Edge). Its outdoor lighting does not render on the WebGL fallback yet, so other browsers show a dark scene. Desktop with a keyboard and mouse recommended."
			}
		</p>
	</section>

	<section class="wrap demo-main">
		<div class="demo-copy">
			<h1>{game.name}</h1>
			<p class="lede">{game.pitch}</p>
			<h2>Controls</h2>
			<dl class="controls">
				{
					game.controls.map((c) => (
						<>
							<dt>{c.keys}</dt>
							<dd>{c.action}</dd>
						</>
					))
				}
			</dl>
		</div>
		<aside class="card shows-off" aria-labelledby="engine">
			<h2 id="engine">What it shows off</h2>
			<ul>
				{
					game.features.map((f) => (
						<li>
							<span class="t">{f.title}</span>
							<span class="d">{f.text}</span>
							{f.links.map((l) => <a href={href(l.href)}>{l.label} →</a>)}
						</li>
					))
				}
			</ul>
			<a class="btn" href={sourceUrl(`apps/${game.app}`)}>View source: apps/{game.app}</a>
			<a class="mono-link" href={`${REPO_URL}/blob/${REPO_BRANCH}/apps/${game.app}/README.md`}>Full README: numbers, URL params, known issues →</a>
		</aside>
	</section>

	<section class="wrap" aria-labelledby="shots" style="padding-bottom: 48px">
		<h2 id="shots" class="sub-title">Screenshots</h2>
		<div class="grid shots">
			{
				game.screenshots.map((s, k) => (
					<img
						src={shot(game, k)}
						alt={s.alt}
						width="1280"
						height="720"
						loading="lazy"
						decoding="async"
					/>
				))
			}
		</div>
	</section>

	<section class="more-section" aria-labelledby="more">
		<div class="wrap">
			<h2 id="more" class="sub-title">More demos</h2>
			<div class="grid more">
				{
					more.map((g) => (
						<a href={pageHref(g)}>
							<img
								src={shot(g)}
								alt=""
								width="1280"
								height="720"
								loading="lazy"
								decoding="async"
							/>
							<span>{g.name}</span>
						</a>
					))
				}
			</div>
		</div>
	</section>
</Base>
